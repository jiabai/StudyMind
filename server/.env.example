# Runtime
NODE_ENV=production
STUDYMIND_SERVER_HOST=127.0.0.1
STUDYMIND_SERVER_PORT=8788
# 生产路径示例（Linux）; 按实际安装位置修改，例如 /opt/studymind/server/data/studymind.sqlite
DATABASE_URL=file:/opt/studymind/server/data/studymind.sqlite

# Identity and secrets (use independent values of at least 32 UTF-8 bytes)
STUDYMIND_ADMIN_EMAIL=admin@example.com
STUDYMIND_AUTH_OTP_HMAC_KEY=
STUDYMIND_LLM_CONFIG_ENCRYPTION_KEY=

# OTP delivery
STUDYMIND_ALLOW_CONSOLE_OTP=false
STUDYMIND_SMTP_HOST=smtp.example.com
STUDYMIND_SMTP_PORT=465
STUDYMIND_SMTP_USER=
STUDYMIND_SMTP_PASS=
STUDYMIND_SMTP_FROM=StudyMind <noreply@example.com>

# WeChat Pay (leave disabled unless every value is configured)
STUDYMIND_WECHAT_PAY_ENABLED=false
STUDYMIND_WECHAT_APP_ID=
STUDYMIND_WECHAT_MCH_ID=
STUDYMIND_WECHAT_MCH_SERIAL_NO=
STUDYMIND_WECHAT_MCH_PRIVATE_KEY=
STUDYMIND_WECHAT_NOTIFY_URL=https://example.com/api/wechat/notify
STUDYMIND_WECHAT_API_V3_KEY=
STUDYMIND_WECHAT_PLATFORM_CERT_PEM=
STUDYMIND_WECHAT_DEV_INSECURE_NOTIFY=false

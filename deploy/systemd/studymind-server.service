# StudyMind server (Fastify API) systemd 服务单元
#
# 监听端口: 8788 (来自 .env 的 STUDYMIND_SERVER_PORT)
# 入口: tsx src/index.ts（与 npm start 等价，源码直跑；build 仅做类型检查，不产出 JS）
#
# 安装步骤:
#   1. 部署代码到 /opt/studymind:
#        sudo mkdir -p /opt/studymind
#        sudo chown studymind:studymind /opt/studymind   # 需先创建用户
#        # 以 studymind 身份拉取代码到 /opt/studymind (server 目录在其下)
#
#   2. 构建/安装依赖:
#        cd /opt/studymind/server
#        npm ci                       # 安装全部依赖(含 dev，tsx 运行时需要)
#        npm run build                # prisma generate && tsc --noEmit (类型检查)
#
#   3. 初始化数据库 (仅本地 SQLite，走迁移历史，禁止 db push):
#        cp .env.example .env         # 按需编辑
#        npm run db:migrate:deploy    # 应用全部迁移
#        npm run db:migrate:status    # 确认迁移状态
#        npm run db:preflight -- --mode current
#
#   4. 注册并启动服务:
#        sudo cp deploy/systemd/studymind-server.service /etc/systemd/system/
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now studymind-server
#
#   5. 验证:
#        systemctl status studymind-server
#        curl -s http://127.0.0.1:8788/health/live
#        curl -s http://127.0.0.1:8788/health/ready
#        journalctl -u studymind-server -f
#
# 注意:
#   - ExecStart 的 tsx 路径按实际安装位置修改: which tsx
#     (npm ci 后通常为 /opt/studymind/server/node_modules/.bin/tsx)
#   - Node 版本要求 >= 20 (项目依赖 fastify ^5)
#   - 应用 shutdown deadline 为 15 秒，TimeoutStopSec=20 留出余量

[Unit]
Description=StudyMind server (Fastify API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studymind
Group=studymind
WorkingDirectory=/opt/studymind/server
EnvironmentFile=/opt/studymind/server/.env
Environment=NODE_ENV=production
# 启动闸门: 迁移已部署、状态正确、数据库预检通过才允许启动。
ExecStartPre=/opt/studymind/server/node_modules/.bin/prisma generate
ExecStartPre=/opt/studymind/server/node_modules/.bin/prisma migrate status
ExecStartPre=/usr/bin/node scripts/database-preflight.mjs --mode current
ExecStart=/opt/studymind/server/node_modules/.bin/tsx src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

# 安全限制
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/studymind/server/data /opt/studymind/server/backups /opt/studymind/server/logs

[Install]
WantedBy=multi-user.target

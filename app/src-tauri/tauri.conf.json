{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyMind",
  "version": "0.2.4",
  "identifier": "com.studymind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StudyMind",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/outputs/**",
          "$APPLOCALDATA/cache/**",
          "$APPLOCALDATA/cache/.StudyMind-audio-review/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRjM5NkNFQ0I3REVBNjEKUldSaDZuM0x6cGJ6NjRaU3plWXZFSXM2azdFQjg4TFNXeWRjN05aNW4vbXJOVGdwcXBXd3NIN1cK",
      "endpoints": [
        "https://github.com/jiabai/StudyMind/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["studymind"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg"],
    "resources": [
      "resources/python/**/*",
      "resources/worker/**/*",
      "resources/bin/**/*",
      "resources/pyproject.toml",
      "resources/.env.template"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

                },
                "styles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "structured",
                      "clear_concise",
                      "deep_explanation",
                      "examples_first",
                      "socratic",
                      "exam_focused",
                      "action_oriented"
                    ]
                  }
                },
                "avoid": {
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "unsupported_claims",
                      "overly_abstract",
                      "too_much_detail",
                      "repetition",
                      "unexplained_jargon",
                      "off_topic",
                      "unverified"
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            "labelSnapshot": {
              "type": "object",
              "required": [
                "profile",
                "generationPreferences"
              ],
              "properties": {
                "profile": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "label",
                      "values"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "role",
                          "domain",
                          "stage",
                          "learningContext",
                          "knowledgeLevel",
                          "studyMethods"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "label"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "label": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "generationPreferences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "label",
                      "values"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "goal",
                          "scenario",
                          "angles",
                          "audience",
                          "styles",
                          "avoid"
                        ]
                      },
                      "label": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "label"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "label": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "preference_snapshot"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "const": "insights"
              }
            }
          }
        }
      ]
    }
  },
  "env": {
    "outputDir": "STUDYMIND_OUTPUT_DIR",
    "cacheDir": "STUDYMIND_CACHE_DIR",
    "modelDir": "STUDYMIND_MODEL_DIR"
  },
  "workerResultKeys": [
    "status",
    "task_id",
    "task_dir",
    "artifacts",
    "text",
    "summary",
    "insights",
    "transcript",
    "dissection",
    "error"
  ],
  "insightResult": {
    "schemaVersion": 1,
    "itemKeys": [
      "id",
      "topic",
      "matchReason",
      "followUpQuestions",
      "suitableUse",
      "sourceChunkId"
    ],
    "preferenceSnapshotArtifact": "preference_snapshot"
  },
  "dissectionResult": {
    "schemaVersion": 1,
    "artifacts": {
      "json": {
        "key": "dissection",
        "path": "ai/dissection.json"
      },
      "markdown": {
        "key": "dissection_md",
        "path": "ai/dissection.md"
      }
    },
    "callPlan": {
      "version": 1,
      "maxChunkCharacters": 2000,
      "chunksPerMapCall": 4,
      "reduceCalls": 1,
      "maxRepairCalls": 1,
      "maxTotalCalls": 6
    },
    "topLevelKeys": [
      "schemaVersion",
      "sourceTranscriptSha256",
      "sourceLanguage",
      "sourceChunks",
      "overallNarrative",
      "segments",
      "highlights",
      "reusableTemplate",
      "audienceFit",
      "strengths",
      "weaknesses"
    ],
    "limits": {
      "highlights": 8,
      "strengths": 6,
      "weaknesses": 6,
      "templateStepsMinimum": 3,
      "templateStepsMaximum": 7
    }
  }

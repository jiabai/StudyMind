                },
                "scenario": {
                  "type": "string",
                  "enum": [
                    "class_notes",
                    "self_study",
                    "exam_review",
                    "work_training",
                    "reading_review",
                    "teach_someone"
                  ]
                },
                "angles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "core_concepts",
                      "key_definitions",
                      "cause_effect",
                      "steps_process",
                      "examples_cases",
                      "compare_contrast",
                      "common_misconceptions",
                      "practice_questions",
